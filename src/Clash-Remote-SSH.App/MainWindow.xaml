<Window Style="{StaticResource {x:Type Window}}" x:Class="ClashRemoteSsh.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClashRemoteSsh.App.Controls"
        Title="ClashSSH遥控台" Width="1240" Height="840" MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}">
    <Grid Background="{DynamicResource Page}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="NavigationPane" Background="{DynamicResource SidebarSurface}" Width="220" ClipToBounds="True">
            <Grid Margin="{Binding SidebarInsets}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="{Binding SidebarHeaderMargin}"><StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Image Source="Assets/AppIcon.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"><TextBlock Text="ClashSSH遥控台" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Clash-Remote-SSH" Style="{StaticResource Caption}" FontSize="9" Margin="0,4,0,0"/></StackPanel></StackPanel><Button x:Name="SidebarToggleButton" Content="&#xE700;" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="ToggleSidebarClicked" ToolTip="展开或收起导航栏" Background="Transparent"/></StackPanel>
                <Grid Grid.Row="1" VerticalAlignment="Top"><StackPanel x:Name="NavigationItems"><RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="4" Click="NavigateClicked" ToolTip="概览" AutomationProperties.Name="概览"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="概览" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"/></StackPanel></RadioButton>
<RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="5" Click="NavigateClicked" ToolTip="SSH 连接" AutomationProperties.Name="SSH 连接"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="SSH 连接" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"/></StackPanel></RadioButton>
<RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="0" Click="NavigateClicked" ToolTip="代理节点" AutomationProperties.Name="代理节点"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="代理节点" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"/></StackPanel></RadioButton>
<RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="1" Click="NavigateClicked" ToolTip="配置" AutomationProperties.Name="配置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="配置" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"/></StackPanel></RadioButton>
<RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="2" Click="NavigateClicked" ToolTip="运行日志" AutomationProperties.Name="运行日志"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="运行日志" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"/></StackPanel></RadioButton>
<RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="3" Click="NavigateClicked" ToolTip="服务管理" AutomationProperties.Name="服务管理"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="服务管理" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarTextVisibility}"/></StackPanel></RadioButton>
</StackPanel><Border x:Name="NavigationIndicator" Width="3" Height="16" Background="{DynamicResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform Y="12"/></Border.RenderTransform></Border></Grid>
                <StackPanel Grid.Row="2">
                    <ui:SmoothBorder CornerRadius="12" Background="{DynamicResource Block}" Padding="12" Margin="0,0,0,14" Visibility="{Binding SidebarTextVisibility}"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding ConnectionBrush}" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock Text="{Binding ConnectionText}" FontSize="11"/></StackPanel><TextBlock Text="服务器代理独立运行" Style="{StaticResource Caption}" FontSize="10" Margin="0,8,0,0"/></StackPanel></ui:SmoothBorder>
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Caption}" FontSize="10" Margin="12,0" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="24,16,24,16">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ui:SmoothBorder Background="{DynamicResource CardSurface}" CornerRadius="16" Padding="12,7" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding HeaderBadge}" FontSize="11" Foreground="{DynamicResource Muted}"/></ui:SmoothBorder><Button Content="&#xE793;" Style="{StaticResource IconButton}" Click="ToggleThemeClicked" ToolTip="切换深色 / 浅色主题"/></StackPanel></Grid>
            <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource PageTabs}" Margin="0,12,0,0" SelectedIndex="5" SelectionChanged="PageChanged">
                <TabItem Header="代理节点">
                        <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="GroupBox" ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectionChanged="GroupChanged" IsEnabled="{Binding CanOperate}"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,10,0" TextChanged="SearchChanged" ToolTip="搜索节点名称或地区"/>
                                <Button Grid.Column="2" Content="↻  刷新" Click="RefreshClicked" IsEnabled="{Binding CanOperate}" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="测试延迟" Click="GroupDelayClicked" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanOperate}"/>
                            </Grid>
                            <ui:SmoothBorder Grid.Row="1" Background="{DynamicResource Block}" CornerRadius="7" Padding="11,9" Margin="0,0,0,12"><TextBlock Text="{Binding CurrentNodeText}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></ui:SmoothBorder>
                            <Grid Grid.Row="2">
                                <ItemsControl x:Name="NodeCards" ItemsSource="{Binding NodesView}" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}" VirtualizingPanel.IsVirtualizing="True">
                                    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="NodeScroll" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:VirtualizingCardPanel ClipToBounds="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button Style="{StaticResource NodeCard}" Tag="{Binding}" Click="UseNodeClicked" ToolTip="{Binding DataContext.NodeSelectionHint, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Name}" AutomationProperties.ItemStatus="{Binding StatusText}">
                                                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" LineHeight="21" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" VerticalAlignment="Top" Margin="0,0,24,0"/>
                                                    <TextBlock Text="✓" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsCurrent, Converter={StaticResource BoolVisibility}}"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Type}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,4"/>
                                                    <TextBlock Grid.Row="2" Text="{Binding DelayText}" Style="{StaticResource NodeLatency}" VerticalAlignment="Center" Margin="0,0,38,0"/>
                                                </Grid>
                                            </Button>
                                            <Button Content="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="NodeDelayClicked" Width="30" Height="26" MinHeight="26" Padding="0" FontSize="13" Margin="0,0,10,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Foreground="{DynamicResource Accent}" ToolTip="仅测试此节点的延迟" AutomationProperties.Name="{Binding Name, StringFormat=测速 {0}}"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EmptyNodesVisibility}" IsHitTestVisible="False"><TextBlock Text="↗" FontSize="42" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyNodesTitle}" Foreground="{DynamicResource Muted}" FontSize="15" Margin="0,14,0,6" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyNodesHint}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
<TabItem Header="配置">
                        <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="↻ 刷新列表" Click="RefreshProfilesClicked" IsEnabled="{Binding CanReadProfiles}" Margin="0,0,8,0"/><Button Content="＋ 添加配置" Style="{StaticResource PrimaryButton}" Click="ImportProfileClicked" IsEnabled="{Binding CanImportProfiles}"/></StackPanel><TextBlock Text="我的配置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding ProfilesHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Configurations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Width="330" Margin="0,0,16,16" IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button Style="{StaticResource ProfileCard}" Tag="{Binding}" Click="SelectProfileClicked" AutomationProperties.Name="{Binding Name, StringFormat=使用配置 {0}}" AutomationProperties.ItemStatus="{Binding ApplyText}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,34,10" MinHeight="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>
                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="5" BorderThickness="0" Background="{DynamicResource Inset}" Foreground="{DynamicResource Accent}" Margin="0,0,0,11"/>
                                        <TextBlock Text="{Binding UsageText}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" FontSize="13"/><TextBlock Text="{Binding ExpiryText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                                        <DockPanel Margin="0,12,0,0"><ui:SmoothBorder DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="10" Padding="8,4" Visibility="{Binding ActiveVisibility}"><TextBlock Text="✓ 正在使用" Foreground="{DynamicResource OnAccent}" FontSize="10"/></ui:SmoothBorder><StackPanel><TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding UpdatedText}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></DockPanel>
                                    </StackPanel>
                                    </Button>
                                    <Button Content="⋯" Tag="{Binding}" Click="ProfileMenuClicked" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,17,15,0" Width="32" Height="32" Padding="0" MinHeight="32" Background="Transparent" BorderThickness="0" IsEnabled="{Binding IsStored}" ToolTip="配置菜单" AutomationProperties.Name="{Binding Name, StringFormat=配置菜单 {0}}"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="连接服务器后，添加订阅链接或 YAML 配置。" Visibility="{Binding NoProfilesVisibility}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Grid>
                    </TabItem>
<TabItem Header="运行日志">
                        <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="读取最近 50 行" Click="LogsClicked" IsEnabled="{Binding CanOperate}"/><TextBlock Text="远端服务日志 · 按需读取，不持续占用连接" Style="{StaticResource Caption}" VerticalAlignment="Center"/></DockPanel>
                            <ui:SmoothBorder Grid.Row="1" CornerRadius="9" Background="{DynamicResource Block}" Padding="12"><TextBox x:Name="LogBox" Text="{Binding RemoteLogText, Mode=OneWay}" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono, Consolas" FontSize="11" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="5"/></ui:SmoothBorder>
                        </Grid>
                    </TabItem>
<TabItem Header="服务管理">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0">
                            <ui:SmoothBorder Background="{DynamicResource Block}" CornerRadius="8" Padding="14" Margin="0,0,0,18"><TextBlock Text="{Binding DeploymentHint}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="21"/></ui:SmoothBorder>
                            <StackPanel Visibility="{Binding InstalledVisibility}">
                            <TextBlock Text="服务遥控" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="复制终端代理命令" Click="CopyProxyClicked" IsEnabled="{Binding CanOperate}"/><TextBlock Text="代理命令需在目标终端粘贴执行，仅影响该终端。" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                            <WrapPanel Margin="0,0,0,22"><Button Content="启动服务" Click="StartClicked" IsEnabled="{Binding CanManageService}" Margin="0,0,8,6"/><Button Content="重启服务" Click="RestartClicked" IsEnabled="{Binding CanManageService}" Margin="0,0,8,6"/><Button Content="停止服务" Click="StopClicked" IsEnabled="{Binding CanManageService}" Margin="0,0,8,6" Foreground="{DynamicResource Error}"/><Button Content="检查代理连通" Click="ConnectivityClicked" IsEnabled="{Binding CanManageService}" Margin="0,0,8,6"/></WrapPanel>
                            <ui:SmoothBorder Background="{DynamicResource ErrorSurface}" CornerRadius="9" Padding="18" Margin="0,0,0,22"><StackPanel><TextBlock Text="移除当前服务" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Error}"/><TextBlock Text="停止并禁用用户服务，移除运行文件。已导入配置保留，系统共享内核不会执行全局卸载。操作前会列出具体文件。" TextWrapping="Wrap" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,10,0,14"/><Button Content="移除并卸载当前服务" Click="UninstallClicked" IsEnabled="{Binding CanManageService}" Foreground="{DynamicResource Error}" BorderBrush="{DynamicResource Error}" HorizontalAlignment="Left"/></StackPanel></ui:SmoothBorder>
                            <Expander Header="环境维护（按需）" Foreground="{DynamicResource Muted}"><StackPanel Margin="0,14,0,0">
                                <Grid Margin="0,0,0,8"><PasswordBox x:Name="SudoPassword" IsEnabled="{Binding CanEnterMaintenancePassword}" PasswordChanged="MaintenancePasswordChanged" AutomationProperties.Name="远端管理员密码"/><TextBlock Text="输入管理员密码" Foreground="{DynamicResource Muted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding MaintenancePlaceholderVisibility}"/></Grid><TextBlock Text="{Binding MaintenancePrivilegeText}" Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <WrapPanel><Button Content="准备 Python / YAML 依赖" Click="BootstrapClicked" IsEnabled="{Binding CanOperate}" Margin="0,0,8,6"/><Button Content="启用脱离登录运行" Click="LingerClicked" IsEnabled="{Binding CanOperate}" Margin="0,0,8,6"/></WrapPanel>
                                <TextBlock Text="准备依赖与启用 linger 需要 root 或 sudo；普通用户安装内核本身不需要 sudo。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel></Expander></StackPanel>
                            <ui:SmoothBorder Style="{StaticResource Card}" Visibility="{Binding UninstalledVisibility}"><StackPanel><TextBlock Text="这台服务器尚未部署服务" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="向导会帮助你准备依赖、导入链接或 YAML，并安装用户服务。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,18"/><Button Content="打开部署向导" Click="OpenWizardClicked" IsEnabled="{Binding CanDeploy}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></ui:SmoothBorder>
                        </StackPanel></ScrollViewer>
                    </TabItem>
<TabItem Header="概览">
    <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid x:Name="OverviewHeader" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ui:SmoothBorder x:Name="ServiceCard" Style="{StaticResource Card}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Height="30"><TextBlock Text="代理服务" Style="{StaticResource Caption}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><ui:SmoothBorder Background="{Binding ServiceSurface}" CornerRadius="12" Padding="9,4" Margin="12,0,0,0"><TextBlock Text="{Binding ServiceText}" Foreground="{Binding ServiceBrush}" FontSize="11"/></ui:SmoothBorder></StackPanel>
                        <TextBlock Text="{Binding ConnectedHost}" ToolTip="{Binding ConnectedHost}" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,14,0,6"/>
                        <Button x:Name="OverviewConnectButton" Content="点击连接" Tag="5" Click="NavigateClicked" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding ConnectPromptVisibility}"/>
                        <TextBlock Text="{Binding ServiceHint}" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource Muted}"/><TextBlock Text="  ·  " Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding PortText}" Foreground="{DynamicResource Muted}"/></StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="26" Style="{StaticResource PrimaryButton}" Width="54" Height="54" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="3" Click="NavigateClicked" ToolTip="打开服务管理"/>
                </Grid>
            </ui:SmoothBorder>
            <Grid x:Name="ProxyModeCard" Grid.Column="2"><ui:SmoothBorder Style="{StaticResource Card}"><StackPanel>
                <Grid Height="30" Margin="0,0,0,14"><TextBlock Text="代理模式" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
                <TabControl x:Name="ProxyModeTabs" Style="{StaticResource ProxyModeTabs}" SelectedIndex="-1" SelectionChanged="ProxyModeChanged" IsEnabled="{Binding CanChangeProxyMode}" ToolTip="直接设置服务器内核模式并保存；不改变系统代理/TUN开关。切换会重连已有代理连接。" AutomationProperties.Name="服务器代理模式">
                    <TabItem Header="规则"><ui:SmoothBorder Background="{DynamicResource Block}" CornerRadius="14" Padding="12"><TextBlock Text="按订阅规则分流，为不同网站选择对应出口。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19"/></ui:SmoothBorder></TabItem>
                    <TabItem Header="全局"><ui:SmoothBorder Background="{DynamicResource Block}" CornerRadius="14" Padding="12"><TextBlock Text="经过此内核的流量统一使用全局分组。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19"/></ui:SmoothBorder></TabItem>
                    <TabItem Header="直连"><ui:SmoothBorder Background="{DynamicResource Block}" CornerRadius="14" Padding="12"><TextBlock Text="经过此内核的流量直接连接目标，不使用代理节点。" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19"/></ui:SmoothBorder></TabItem>
                </TabControl>
                <TextBlock Text="{Binding ProxyModeStatus}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel></ui:SmoothBorder><ui:LoadingBorder IsActive="{Binding IsModeChanging}"/></Grid>
            </Grid>
            <UniformGrid Columns="3" Margin="0,0,-16,16">
                <ui:SmoothBorder Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="运行模式" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ModeText}" FontSize="22" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Text="遵循远端当前配置" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></ui:SmoothBorder>
                <ui:SmoothBorder Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="当前分组" Style="{StaticResource Caption}"/><TextBlock Text="{Binding GroupCountText}" FontSize="22" FontWeight="SemiBold" Margin="0,13,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NodeCountText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></ui:SmoothBorder>
                <ui:SmoothBorder Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="SSH 连接" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ConnectionText}" FontSize="20" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Text="加密连接 · 本机遥控" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></ui:SmoothBorder>
            </UniformGrid>
            <Grid x:Name="OverviewTools" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid x:Name="NetworkCard"><ui:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Height="30" Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="↻" Padding="10,4" MinHeight="28" Click="RefreshNetworkClicked" IsEnabled="{Binding CanReadNetwork}" ToolTip="刷新远端网络状态"/><TextBlock x:Name="NetworkCardTitle" Text="网络设置" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                        <TabControl x:Name="NetworkModeTabs" Style="{StaticResource NetworkTabs}" SelectedIndex="0" SelectionChanged="NetworkTabChanged">
                            <TabItem Header="系统代理">
                                <ui:SmoothBorder Background="{DynamicResource Block}" CornerRadius="18" Padding="12,8">
                                    <StackPanel><DockPanel Margin="0,0,0,4"><ToggleButton x:Name="SystemProxySwitch" DockPanel.Dock="Right" Style="{StaticResource NetworkSwitch}" IsChecked="{Binding SystemProxyEnabled, Mode=OneWay}" IsEnabled="{Binding CanChangeSystemProxy}" Click="SystemProxyClicked" AutomationProperties.Name="服务器系统代理"/><TextBlock Text="系统代理" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding SystemProxyHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="18"/></StackPanel>
                                </ui:SmoothBorder>
                            </TabItem>
                            <TabItem Header="TUN 虚拟网卡">
                                <ui:SmoothBorder Background="{DynamicResource Block}" CornerRadius="18" Padding="12,8">
                                    <StackPanel><DockPanel Margin="0,0,0,4"><ToggleButton x:Name="TunSwitch" DockPanel.Dock="Right" Style="{StaticResource NetworkSwitch}" IsChecked="{Binding TunEnabled, Mode=OneWay}" IsEnabled="{Binding CanChangeTun}" Click="TunClicked" AutomationProperties.Name="远端 TUN 虚拟网卡" ToolTip="点击开启；缺少权限时先准备。切换会重启代理并重新建立连接。"/><TextBlock Text="TUN 虚拟网卡" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding TunHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="18"/></StackPanel>
                                </ui:SmoothBorder>
                            </TabItem>
                        </TabControl>
                        <TextBlock Text="{Binding NetworkOperationText}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,10,0,0" Visibility="{Binding NetworkOperationVisibility}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:SmoothBorder><ui:LoadingBorder IsActive="{Binding IsNetworkChanging}"/></Grid>
                <Grid x:Name="SitesCard" Grid.Column="2" ToolTip="{Binding WebsiteTestHint}"><ui:SmoothBorder Style="{StaticResource Card}">
                    <StackPanel><DockPanel Height="30" Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="全部测试" Click="TestSitesClicked" Tag="all" Padding="13,6" MinHeight="30" IsEnabled="{Binding CanTestSites}"/><TextBlock x:Name="SitesCardTitle" Text="网站测试" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                        <ItemsControl x:Name="WebsiteCards" ItemsSource="{Binding Sites}" Margin="0,0,-4,-8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                            <ui:SmoothBorder Background="{DynamicResource Block}" CornerRadius="14" Padding="6,10" Margin="0,0,4,8">
                                <StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding Mark}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                    <Button Content="{Binding ResultText}" Tag="{Binding Id}" Click="TestSitesClicked" Padding="2,2" MinHeight="26" Margin="0,7,0,0" Foreground="{Binding ResultBrush}" Background="Transparent" IsEnabled="{Binding DataContext.CanTestSites, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Detail}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center" ToolTip="{Binding Detail}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ui:SmoothBorder>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ui:SmoothBorder><ui:LoadingBorder IsActive="{Binding IsSitesTesting}"/></Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</TabItem>
<TabItem Header="SSH 连接">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <ui:SmoothBorder Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="连接你的 Linux 服务器" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="使用已有 SSH 密钥，或通过账号密码登录。" Style="{StaticResource Caption}" Margin="0,8,0,24"/>
                    <StackPanel IsEnabled="{Binding CanEditConnection}">
                        <TextBlock Text="服务器地址" Style="{StaticResource SideLabel}"/>
                        <Grid x:Name="ServerAddressRow" Margin="0,0,0,18">
                            <TextBox x:Name="HostBox" Text="example.invalid" Padding="12,8,52,8" TextChanged="ConnectionTargetEdited" AutomationProperties.Name="服务器地址"/>
                            <ComboBox x:Name="SavedServersBox" ItemsSource="{Binding SavedConnections}" SelectionChanged="SavedServerChanged" DropDownClosed="SavedServerDropdownClosed"
                                      Style="{StaticResource SavedServerSelector}" Width="44" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                      AutomationProperties.Name="已保存的服务器" ToolTip="选择已保存的服务器，自动填入登录信息">
                                <ComboBox.ItemTemplate><DataTemplate>
                                    <StackPanel MaxWidth="610">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AuthenticationLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="用户名" Style="{StaticResource SideLabel}"/><TextBox x:Name="UserBox" Text="user" TextChanged="ConnectionTargetEdited"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="端口" Style="{StaticResource SideLabel}"/><TextBox x:Name="PortBox" Text="22" TextChanged="ConnectionTargetEdited"/></StackPanel>
                        </Grid>
                        <TextBlock Text="登录方式" Style="{StaticResource SideLabel}"/>
                        <ComboBox x:Name="AuthBox" SelectedIndex="0" SelectionChanged="AuthChanged" Margin="0,0,0,18"><ComboBoxItem Content="系统 SSH · 免密登录"/><ComboBoxItem Content="SSH 账号密码"/></ComboBox>
                        <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,0,0,18"><TextBlock Text="SSH 密码 · 连接成功后加密保存" Style="{StaticResource SideLabel}"/><PasswordBox x:Name="LoginPassword"/></StackPanel>
                        <Expander Header="高级连接设置" Foreground="{DynamicResource Muted}" Margin="0,0,0,20">
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="私钥文件（系统 SSH 可选）" Style="{StaticResource SideLabel}"/><TextBox x:Name="IdentityBox" Margin="0,0,0,14" TextChanged="ConnectionTargetEdited"/>
                                <TextBlock Text="用户服务名" Style="{StaticResource SideLabel}"/><TextBox x:Name="ServiceBox" Text="clash-verge.service" Margin="0,0,0,14"/>
                                <TextBlock Text="远端配置文件" Style="{StaticResource SideLabel}"/><TextBox x:Name="ConfigBox" Text="~/.config/clash-verge/config.yaml" Margin="0,0,0,14"/>
                                <TextBlock Text="管理 API 端口" Style="{StaticResource SideLabel}"/><TextBox x:Name="ApiPortBox" Text="9090"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConnectButton" Content="连接服务器" Style="{StaticResource PrimaryButton}" Click="ConnectClicked" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" MinWidth="140"/>
                        <Button x:Name="ForgetConnectionButton" Content="删除记录" Click="ForgetConnectionClicked" IsEnabled="{Binding CanForgetConnection}" Margin="12,0,0,0" ToolTip="删除当前服务器的本机连接记录和保存的密码，保留主机信任记录。"/>
                    </StackPanel>
                </StackPanel>
            </ui:SmoothBorder>
            <ui:SmoothBorder Style="{StaticResource Card}"><TextBlock Text="连接成功后自动记住服务器；密码使用 Windows 当前用户加密保存，免密登录仅保存私钥路径。首次连接仍需核对主机指纹，管理员密码不保存。校园网服务器请先连接 VPN。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="22"/></ui:SmoothBorder>
        </StackPanel>
    </ScrollViewer>
</TabItem>
            </TabControl>
            <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource Inset}" Visibility="{Binding BusyVisibility}" Margin="0,0,0,9"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/><TextBlock Grid.Column="1" Text="{Binding SampleText}" Style="{StaticResource Caption}" FontSize="10" Margin="12,0,0,0"/></Grid></Grid>
        </Grid>
    </Grid>
</Window>
