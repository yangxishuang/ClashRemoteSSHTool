<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Accent" Color="#3488FF"/>
    <SolidColorBrush x:Key="Ink" Color="#E5E5EB"/>
    <SolidColorBrush x:Key="Muted" Color="#ACACB6"/>
    <SolidColorBrush x:Key="Page" Color="#111113"/>
    <SolidColorBrush x:Key="CardSurface" Color="#202023"/>
    <SolidColorBrush x:Key="Block" Color="#2B2B2F"/>
    <SolidColorBrush x:Key="Inset" Color="#39393F"/>
    <SolidColorBrush x:Key="SidebarSurface" Color="#1A1A1D"/>
    <SolidColorBrush x:Key="NavigationSelected" Color="#2D2D33"/>
    <SolidColorBrush x:Key="Outline" Color="#46464D"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Success" Color="#8DD894"/>
    <SolidColorBrush x:Key="Warning" Color="#E6AF56"/>
    <SolidColorBrush x:Key="SuccessSurface" Color="#173E21"/>
    <SolidColorBrush x:Key="Error" Color="#FF9FAA"/>
    <SolidColorBrush x:Key="ErrorSurface" Color="#4F222A"/>
    <SolidColorBrush x:Key="StateLayer" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#202023"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#202023"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.AppWorkspaceBrushKey}" Color="#202023"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E5E5EB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E5E5EB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#ACACB6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2B2B2F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E5E5EB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#46464D"/>
</ResourceDictionary>
