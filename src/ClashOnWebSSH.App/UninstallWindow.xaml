<Window x:Class="ClashOnWebSSH.App.UninstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="移除并卸载当前服务" Width="660" Height="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7FC" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#17243B">
    <Border Background="#F5F7FC"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="移除当前用户服务" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="代理连接将中断。已导入配置和当前配置快照会保留。" Foreground="#BF6575" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14"><TextBox x:Name="PlanText" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="12"/></Border>
        <StackPanel Grid.Row="2" Margin="0,18,0,14"><TextBlock x:Name="ConfirmHint" Margin="0,0,0,8"/><TextBox x:Name="ConfirmBox" TextChanged="ConfirmationChanged"/></StackPanel>
        <Button x:Name="RemoveButton" Grid.Row="3" Content="确认停止并卸载当前服务" Background="#C65870" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" IsEnabled="False" Click="RemoveClicked"/>
    </Grid></Border>
</Window>
